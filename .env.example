# Vorlage für die lokale Konfiguration.
# Kopieren nach `.env` (wird von Git ignoriert) und den eigenen Schlüssel eintragen:
#
#   cp .env.example .env
#
# Der Schlüssel wird ausschließlich vom lokalen Entwicklungsserver (`node serve.mjs`)
# an den Browser übergeben und von dort nur an api.anthropic.com gesendet. Er landet
# weder in localStorage noch in einem Profil-Export. Beim Deployment auf GitHub Pages
# gibt es diesen Server nicht — dort greift wieder die Schlüssel-Eingabe im Browser.

ANTHROPIC_API_KEY=
